PORT=5000
NODE_ENV=development

# PostgreSQL
DB_NAME=health_finance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# CORS - your frontend URL
CLIENT_URL=http://localhost:3000

# Officer / counsellor dashboard (send as the x-officer-key header)
OFFICER_KEY=change_this_officer_key

# --- Phone (IVR) and WhatsApp bridge ---
# The public https URL this server is reachable at (Render/Railway URL, or an
# ngrok URL while testing locally). Required for the Twilio signature check
# to pass once TWILIO_AUTH_TOKEN is set (see src/middleware/twilioSignature.js).
PUBLIC_BASE_URL=https://your-app.onrender.com

# From the Twilio Console. Configure your Twilio phone number's "A call comes
# in" webhook to POST {PUBLIC_BASE_URL}/api/channels/voice/incoming, and your
# WhatsApp sender's webhook to POST {PUBLIC_BASE_URL}/api/channels/whatsapp/incoming.
# Leaving TWILIO_AUTH_TOKEN unset skips webhook signature verification, which
# is fine for local testing but must be set before a real number is public.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional. Without this, WhatsApp voice notes are not transcribed and the
# bridge asks the sender to type instead — phone call (IVR) speech recognition
# does NOT need this, since Twilio transcribes call speech itself.
OPENAI_API_KEY=
