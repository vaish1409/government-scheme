PORT=5000
NODE_ENV=development

# PostgreSQL
DB_NAME=health_finance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# CORS - your frontend URL
CLIENT_URL=http://localhost:3000

# Officer / counsellor dashboard (send as the x-officer-key header)
OFFICER_KEY=change_this_officer_key
