# Copy this file to ".env" in the SAME folder as docker-compose.yml, on the
# EC2 instance. Never commit the real ".env" to git — it has real secrets.
#
# Generate a random JWT secret with:
#   openssl rand -hex 32

DB_NAME=health_finance_db
DB_USER=postgres
DB_PASSWORD=change_this_to_a_long_random_password

JWT_SECRET=change_this_to_a_long_random_string

# The address people will actually load the app from — your EC2 Elastic IP
# (e.g. http://3.110.xxx.xxx) or a DuckDNS domain once you set one up.
# Used for CORS and for the Twilio webhook URL, if you ever wire that up.
CLIENT_URL=http://YOUR_ELASTIC_IP

# Shown to the "officer dashboard" via the x-officer-key header — pick
# something only you know.
OFFICER_KEY=change_this_officer_key

# Optional — leave blank unless you've set up a real Twilio account for the
# IVR/WhatsApp channels described in backend/.env.example.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OPENAI_API_KEY=
